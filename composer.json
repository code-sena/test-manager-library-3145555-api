{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "valerysinai/manager-library-api",
    "type": "project",
    "description": "Manager Library API built with Laravel following the project specification.",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "~12.5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
