APP_NAME="Manager Library API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=library

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Se configurarán al implementar autenticación y portadas. No guardar secretos aquí.
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173
COVERS_DIR=storage/app/private/covers
CLOCK_MODE=system
